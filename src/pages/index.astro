---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';
---
<Layout>
  <App client:only="react">
    <main slot="fallback" class="page startup"><span class="footer-brand">chapter.</span><p>Opening your little corner of knowledge…</p></main>
